# Copy to .env.local (gitignored) and fill in only what you want to override — every value here
# has a working default baked into src/config.ts, so the app builds and runs with no .env at all.

# Point at a local `wrangler dev` server instead of the deployed signaling Worker.
# VITE_SIGNALING_URL=http://127.0.0.1:8787

# Point at a different Supabase project (e.g. a local `supabase start` stack).
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NOTE: never put the service-role / sb_secret_... key in here. It bypasses row-level security
# entirely, and anything in a VITE_ variable is compiled into the public JavaScript bundle. That
# key belongs only in the signaling Worker, via `wrangler secret put SUPABASE_SERVICE_KEY`.
