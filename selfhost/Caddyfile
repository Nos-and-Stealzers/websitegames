# Serves the game files from home, with automatic HTTPS.
#
# This is the piece GitHub Pages cannot do: games-huge is 3.7 GB and hd_fnaf
# is 4.2 GB, both well past the 1 GB per-site cap. Serving them yourself has
# no such limit.
#
# Caddy gets a certificate from Let's Encrypt on its own — no certbot, no
# renewal cron. It needs ports 80 and 443 reachable for that.
#
#   caddy run --config selfhost/Caddyfile
#
# Change the hostname below to whatever you point at this machine.

games.arcadecampushub.online {

	root * /srv/games
	encode zstd gzip

	# The hub embeds these in an iframe from another origin, so it must not
	# be told to refuse framing. Deliberately no X-Frame-Options here.
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
	}

	# THE important part if you care about your own network speed.
	#
	# Measured on this connection: 38 Mbps up, and latency goes 64 ms -> 147 ms
	# while uploading. Serving every request from here would make the house feel
	# slow whenever someone loads a game.
	#
	# These headers let Cloudflare cache the files at its edge, so your line
	# uploads each file ONCE and Cloudflare serves everyone after that. Upload
	# use drops to near nothing once warm. Without them Cloudflare revalidates
	# constantly and you pay the upload every time.
	#
	# Game builds are immutable in practice — an update lands under a new path —
	# so a long max-age is safe.
	@assets {
		path *.png *.jpg *.jpeg *.gif *.webp *.svg *.mp3 *.ogg *.wav *.woff2
		path *.data *.wasm *.unityweb *.js *.css *.json *.mem *.symbols
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML changes when you update a game. Still cache it at the edge, just
	# briefly, so a burst of players doesn't each cost an upload.
	@html path *.html
	header @html Cache-Control "public, max-age=300, s-maxage=3600"

	# Unity builds ship pre-compressed payloads that must be labelled, or the
	# loader rejects them.
	@br path *.br
	header @br Content-Encoding br
	@gz path *.unityweb *.gz
	header @gz Content-Encoding gzip

	file_server browse
	log {
		output file /var/log/caddy/games.log
		format console
	}
}

# Optional: the Node backend, if you'd rather run it than use Supabase.
# Delete this block if Supabase is doing the job.
